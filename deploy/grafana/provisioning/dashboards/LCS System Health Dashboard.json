      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "rate(container_cpu_cfs_throttled_seconds_total[1m])",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": null,
      "title": "Container Memory Limit %",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes / container_spec_memory_limit_bytes * 100",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": null,
      "title": "Container OOM",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 3,
        "x": 16,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "increase(container_oom_events_total[24h])",
          "legendFormat": "__auto",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": null,
      "title": "Go Routines (gateway)",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 19,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },
      "targets": [
        {
          "expr": "go_goroutines{job=\"gateway\"}",
          "legendFormat": "goroutines",
          "refId": "A"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
